# 🌌 CEKCEK SUPER BOT v4.0 - CONFIGURATION EXAMPLE
# Copy this file to .env and fill in your own values
# Generated: 2024-01-15
# All values are preconfigured and ready to use

# ============================================
# NETWORK & CONTRACT SETTINGS
# ============================================
# 🚀 MAINNET MODE - Polygon Mainnet
POLYGON_RPC_URL=https://polygon.rpc.thirdweb.com
POLYGON_WS_URL=https://polygon.rpc.thirdweb.com
CONTRACT_ADDRESS=0xdC34033509Bb6563309C59f64265Cc55FFF55eE4

# ============================================
# MULTI-CHAIN RPC URLS (Public + Free)
# HTTP URLs (More Stable)
# ============================================
ETH_WS_URL=https://ethereum.publicnode.com
BSC_WS_URL=https://bsc.publicnode.com
AVAX_WS_URL=https://avalanche.publicnode.com
ARB_WS_URL=https://arbitrum.publicnode.com
BASE_WS_URL=https://base.publicnode.com

# ============================================
# WALLET & KEYS
# ⚠️ NEVER COMMIT THIS FILE TO GIT
# ============================================
# Kullanıcı kendi private key'ini buraya eklemesi gerek
# Örnek format: 0x1234567890abcdef...
PRIVATE_KEY=0xc29f4e014b65eb579f4f2048969b8fb6b6a851a02115f728d802cce5f9bd2f11
ACCOUNT_ADDRESS=0x06E83497F599D67447EfFfeA399cC885CEB6eEff

# ============================================
# CHAIN CONFIGURATION
# ============================================
CHAIN_ID=137
CHAIN_NAME=Polygon

# ============================================
# CONTRACT ADDRESSES (Smart Gate & Green Token)
# ============================================
GREEN_TOKEN_ADDRESS=0x88AB810eAE8d41C8388402E53d6Cd2DDD645cDdE
ROUTER_ADDRESS=0xa5e0829caced8ffdd052420551415491d6993e2f
COMMISSION_WALLET=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
PAYOUT_WALLET=0x06E83497F599D67447EfFfeA399cC885CEB6eEff

# ============================================
# PRODUCTION MODE (true = gerçek işlem)
# ============================================
# ⚠️ PRODUCTION MODE - Gerçek işlemler yapılacak! (Cüzdan kontrolü yapıldı)
PRODUCTION_MODE=true
NODE_ENV=production

# ============================================
# FLASH LOAN AMPLIFIER (10x-50x kaldıraç)
# ============================================
FLASH_LOAN_ENABLED=true

# Flash Loan parametreleri
# Aave Flash Loan için maksimum katılı miktar
FLASH_LOAN_LEVERAGE=10

# Flash Loan protokolü (aave / uniswapv3)
FLASH_LOAN_PROTOCOL=aave

# Fırsat bulunduğunda ödünç alınacak miktar (USDC cinsinden)
# 1000 USDC sermaye x 10 leverage = 10,000 USDC işlem
FLASH_LOAN_AMOUNT=10000000000

# ============================================
# FLASHBOTS CONFIGURATION
# MEV Protection + Private Mempool
# ============================================
FLASHBOTS_RELAY=https://relay.flashbots.net
MEV_SHARE_RELAY=https://mev-share.flashbots.net
FLASHBOTS_ENABLED=true

# ============================================
# BOT CONFIGURATION
# ============================================
# Scan interval in milliseconds
# AGGRESSIVE MODE: Her 2 saniyede bir tarama
SCAN_INTERVAL=2000

# Daily trading limit (ne kadar işlem girebileceği)
DAILY_TRADE_LIMIT=50

# Minimum liquidity threshold (50,000 USDC altındaki havuzları yok say)
# 50000 USDC = 50000000000 (6 decimals)
MIN_LIQUIDITY=50000000000

# Minimum profit threshold (Spread > %0.5 = FIRSAT)
# (in USDC, 6 decimals)
MIN_PROFIT_THRESHOLD=0.005

# Gas price threshold (Gwei)
GAS_PRICE_THRESHOLD=200

# Slippage tolerance (%) - İşlem sırasında %5'e kadar düşüş kabul
SLIPPAGE_TOLERANCE=5

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================
# NETWORK MONITORING
# ============================================
WATCHDOG_ENABLED=true
WATCHDOG_CHECK_INTERVAL=10000
MAX_CONSECUTIVE_ERRORS=5
RECONNECT_DELAY=5000

# ============================================
# GAS OPTIMIZATION
# ============================================
GAS_LIMIT=500000
MAX_GAS_PRICE=300

# ============================================
# LIQUIDITY FRAGMENTER
# Aggregator APIs (No key needed for basic calls)
# ============================================
ONEINCH_API=https://api.1inch.io/v6.0
PARASWAP_API=https://api.paraswap.io/v2
OPENOCEAN_API=https://api.openocean.finance/v3

# ============================================
# OCEAN PROTOCOL & SUBGRAPH
# ============================================
AQUARIUS_URL=https://subgraph.mainnet.oceanprotocol.com/subgraphs/name/oceanprotocol/ocean-subgraph

# ============================================
# AI PREDICTOR CONFIGURATION
# ============================================
AI_MODEL_TYPE=linear_regression
AI_MIN_DATA_POINTS=10
AI_PREDICTION_CONFIDENCE_THRESHOLD=0.75
USE_AI_ANALYSIS=true
GEMINI_API_KEY=

# ============================================
# DARK FOREST DEFENSE
# ============================================
OBFUSCATION_LEVEL=high
DECOY_TRANSACTIONS=2
ROUTER_RANDOMIZATION=true
TIMING_RANDOMIZATION=true

# ============================================
# SELF-HEALING WATCHDOG
# Public RPC URLs (Free, No Key Required)
# ============================================
PROVIDER_1_URL=https://polygon.rpc.thirdweb.com
PROVIDER_2_URL=https://polygon.publicnode.com
PROVIDER_3_URL=https://1rpc.io/matic

# Max failover attempts
MAX_FAILOVER_ATTEMPTS=10

# Portfolio capital (in USDC, 6 decimals)
PORTFOLIO_CAPITAL=1000000000

# Max risk per trade (%)
MAX_RISK_PER_TRADE=5

# ============================================
# STATISTICS & MONITORING
# ============================================
STATS_FILE=./bot-stats-pro.json
STATS_INTERVAL=60000

# ============================================
# ADVANCED: Colocation Server (Optional)
# ============================================
# For ultra-low latency, deploy to AWS/Google Cloud
# COLOCATION_SERVER=tokyo.aws.amazon.com
# COLOCATION_LATENCY_TARGET=10

# ============================================
# DEBUG MODE (Development Only)
# ============================================
DEBUG=false
VERBOSE_LOGGING=false

# ============================================
# SECURITY
# ============================================
ENABLE_HTTPS=true
VERIFY_CONTRACT_ADDRESS=true
VALIDATE_TRANSACTION_DATA=true

# ============================================
# DATABASE (MongoDB)
# ============================================
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/cekcek-bot

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
MARKETPLACE_API_URL=
MIDDLEWARE_URL=https://hook.make.com/your-webhook-id
OPENSEA_API_URL=https://api.opensea.io/v1/asset/create
GOOGLE_SHEETS_URL=

# ============================================
# TELEGRAM BOT (Optional)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# ADDITIONAL SETTINGS
# ============================================
COMMISSION_RATE=0.10
MAX_PRIORITY_FEE=35000000000
MIN_REINVEST_THRESHOLD=5
BATCH_MINING=true
AUTO_REINVEST=false
SHARED_DISTRIBUTION_POOL_ENABLED=false
PUBLISH_BATCH_SIZE=10
BATCH_TRADE_THRESHOLD_MB=500
RPC_TIMEOUT=60000
CONFIG_OVERRIDE=false

# ============================================
# SETUP INSTRUCTIONS (👇 ÖNEMLİ)
# ============================================
# 1. PRIVATE_KEY'yi kendi wallet private key'inle değiştir
#    Örnek: 0x123abc456def789...
#
# 2. ACCOUNT_ADDRESS'i kendi wallet address'inle değiştir
#    Örnek: 0x742d35Cc6634C0532925a3b844Bc023f18bB6b08
#
# 3. MONGO_URI'yi kendi MongoDB connection string'inle değiştir
#
# 4. PRODUCTION_MODE=true yap (işlem göndermek için)
#
# 5. Bot başlat: npm run dev
#
# ⚠️ Dikkat:
# - Private key asla public git repo'ya koyma
# - Testnet'te ilk dene, sonra mainnet
# - İlk işlemleri küçük miktarla başla
#
# Generated by CEKCEK SUPER BOT v4.0
# Last updated: 2024-01-15
