    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "ethers": "^5.7.2",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.12.1",
    "motion": "^12.23.24",
    "node-telegram-bot-api": "^0.67.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
